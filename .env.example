# ==============================================================================
# ZeroWait — Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local and populate with your credentials.
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Store & Local Development Configuration
NEXT_PUBLIC_DEFAULT_STORE_CODE=AVENUE-001
ALLOW_LOCAL_DEV_STORE=true
NODE_ENV=development

